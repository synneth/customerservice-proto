# ElevenLabs API-nøkkel — finn den på https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=din_api_nøkkel_her

# Agent-ID — sett inn etter du har kjørt POST /api/setup-agent
ELEVENLABS_AGENT_ID=

# URL der backenden kjører (viktig for at ElevenLabs kan nå webhook-endepunktene)
# Lokalt: http://localhost:8000
# Produksjon: https://din-server.no
BACKEND_URL=http://localhost:8000
