# ElevenLabs API-nøkkel — finn den på https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=din_api_nøkkel_her

# Agent-ID — sett inn etter du har kjørt POST /api/setup-agent
ELEVENLABS_AGENT_ID=

# NB: ingen BACKEND_URL / ngrok nødvendig lengre. Alle verktøy kjører som
# "client"-tools over nettleserens egen WebSocket-forbindelse til ElevenLabs,
# så backend trenger aldri å være nåbar fra internett for å kjøre demoen
# lokalt. Se README for hvordan dette endres tilbake til webhook-tools den
# dagen dere kobler til ekte telefoni (uten nettleser).
